{
  "name": "ace-wireframe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "render": "python3 render.py",
    "build:css": "tailwindcss -i ./src/input.css -o ./output.css --minify",
    "build": "npm run render && npm run build:css",
    "watch": "tailwindcss -i ./src/input.css -o ./output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
